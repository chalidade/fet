{
  "name": "fet",
  "private": true,
  "description": "Front-End Toolkits: roadmap, panduan deep dive, dan toolkit front-end yang bisa di-install.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:typecheck": "vue-tsc --noEmit -p docs/.vitepress/tsconfig.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@supabase/supabase-js": "^2.118.0",
    "@types/markdown-it": "^14.2.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.17.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^2.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  }
}

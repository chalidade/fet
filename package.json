{
  "name": "fet",
  "private": true,
  "description": "Front-End Training: roadmap, panduan deep dive, dan toolkit front-end yang bisa di-install.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "test": "pnpm -r --filter \"./packages/**\" test",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "docs:dev": "pnpm --filter @chalidade/learn-theme build && vitepress dev docs",
    "docs:build": "pnpm --filter @chalidade/learn-theme build && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:typecheck": "vue-tsc --noEmit -p docs/.vitepress/tsconfig.json"
  },
  "devDependencies": {
    "@chalidade/learn-theme": "workspace:*",
    "@changesets/cli": "^2.27.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.17.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^2.1.0",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  }
}

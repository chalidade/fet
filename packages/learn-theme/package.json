{
  "name": "@chalidade/learn-theme",
  "version": "0.0.0",
  "description": "Tema VitePress untuk situs belajar: Ruang Belajar, komunitas, profil, Bukti Belajar, dan checklist konsep (Supabase + Google Drive).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./markdown": {
      "types": "./src/markdown/taskList.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./node": {
      "types": "./src/concepts.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./style.css": "./src/style.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup --entry.markdown=src/markdown/taskList.ts --entry.node=src/concepts.ts --format esm,cjs --clean --out-dir dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vitepress": "^1.6.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@supabase/supabase-js": "^2.118.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "markdown-it": "^14.3.3"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  }
}
